{
  "name": "@wes/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing.ts",
    "./embedded": "./src/embedded.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@wes/shared": "workspace:^",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3",
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-pgvector": "^0.0.11"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31",
    "tsx": "^4.23.15"
  }
}
