{
  "name": "@wes/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --enable-source-maps dist/server.js",
    "openapi": "tsx src/scripts/write-openapi.ts",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-pgvector": "^0.0.11",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@wes/agent": "workspace:^",
    "@wes/db": "workspace:^",
    "@wes/shared": "workspace:^",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5",
    "jose": "^6",
    "postgres": "^3",
    "zod": "^4"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
