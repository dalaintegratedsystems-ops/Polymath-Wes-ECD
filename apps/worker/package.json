{
  "name": "@wes/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "ingest": "tsx --env-file-if-exists=../../.env src/scripts/ingest.ts"
  },
  "dependencies": {
    "@wes/agent": "workspace:^",
    "@wes/db": "workspace:^",
    "@wes/shared": "workspace:^",
    "bullmq": "^5",
    "zod": "^4"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
