# Copy to .env and fill in. Never commit .env.
# Values below work with `docker compose up` for local development.

NODE_ENV=development

# --- Database (docker compose) ---
# Owner role: runs migrations and seed. Never used by the API at runtime.
DATABASE_OWNER_URL=postgres://wes_owner:wes_owner_dev@localhost:5432/wes
# App role: used by the API. Subject to row-level security (no BYPASSRLS).
DATABASE_URL=postgres://wes_app:wes_app_dev@localhost:5432/wes
# Worker role: scoped grants for background jobs.
DATABASE_WORKER_URL=postgres://wes_worker:wes_worker_dev@localhost:5432/wes

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Blob storage (MinIO locally, Azure Blob in production) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=af-south-1
S3_BUCKET=wes-local
S3_ACCESS_KEY_ID=wes
S3_SECRET_ACCESS_KEY=wes_minio_dev

# --- Mail (Mailpit) ---
SMTP_URL=smtp://localhost:1025

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SIGNING_SECRET=change-me-dev-only-secret-at-least-32-bytes-long
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_SECONDS=2592000
# Where OTPs go in development: console | whatsapp | sms
OTP_DELIVERY=console

# --- Field-level encryption (guardian contact details) ---
# 32-byte keys, base64. Production keys live in Azure Key Vault.
FIELD_ENCRYPTION_KEY=ZGV2LW9ubHktZmllbGQta2V5LTMyLWJ5dGVzLW9rISE=
BLIND_INDEX_KEY=ZGV2LW9ubHktYmxpbmQtaW5kZXgta2V5LTMyYnl0ZSE=

# --- AI (models are configurable; never hard-code in business logic) ---
ANTHROPIC_API_KEY=<<ANTHROPIC_API_KEY>>
WES_MODEL_ROUTER=claude-haiku-5-5
WES_MODEL_MAIN=claude-sonnet-5-5
WES_MODEL_ESCALATION=claude-opus-5-5
WES_MAX_TOOL_CALLS=6
WES_MONTHLY_TOKEN_BUDGET_PER_CENTRE=2000000

# --- Embeddings (ADR-0006) ---
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-multilingual-2
EMBEDDING_DIMENSIONS=1024
VOYAGE_API_KEY=<<VOYAGE_API_KEY>>

# --- Channels ---
WHATSAPP_PHONE_NUMBER_ID=<<WHATSAPP_PHONE_NUMBER_ID>>
WHATSAPP_ACCESS_TOKEN=<<WHATSAPP_ACCESS_TOKEN>>
WHATSAPP_VERIFY_TOKEN=<<WHATSAPP_VERIFY_TOKEN>>
WHATSAPP_APP_SECRET=<<WHATSAPP_APP_SECRET>>
SMS_PROVIDER=mock
SMS_PROVIDER_CREDENTIALS=<<SMS_PROVIDER_CREDENTIALS>>

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
